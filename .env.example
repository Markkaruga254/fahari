# Copy to .env and fill in. NEVER commit .env.

# --- App ---
APP_ENV=dev
DEMO_MODE=true
PUBLIC_BASE_URL=https://REPLACE-WITH-TUNNEL-URL
AUTO_CREATE_DB=true

# --- Security ---
# Long random string; it becomes part of the webhook URL: /ussd/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-long-random
PHONE_HASH_PEPPER=change-me-another-long-random
DASHBOARD_API_KEY=change-me-dashboard-key

# --- Database (host-run app; compose overrides host to "db") ---
DATABASE_URL=postgresql+psycopg://pp:pp@localhost:5432/pp

# --- Africa's Talking (sandbox username is always "sandbox") ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_VOICE_NUMBER=

# --- AI (Gate 3) ---
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# --- Speech-to-text (Gate 6) ---
STT_PROVIDER=fake
STT_API_KEY=
